# === 贾维斯配置 ===
# 复制本文件为 .env 并填入真实值

# LLM 提供商: echo(离线演示) | openai_compat(任何 OpenAI 兼容接口)
JARVIS_PROVIDER=echo

# OpenAI 兼容接口配置（DeepSeek / Kimi / 通义 / 自建网关均可）
JARVIS_API_KEY=
JARVIS_BASE_URL=https://api.deepseek.com/v1
JARVIS_MODEL=deepseek-chat

# 记忆保留的最大对话轮数
JARVIS_MAX_TURNS=20

# ---- v0.2：流式输出与工具调用 ----
# 流式输出（逐字显示）
JARVIS_STREAM=true
# 是否把本地技能作为工具交给 LLM 调用（function calling）
JARVIS_TOOLS=true
# 单次对话内最多几轮工具调用（防止模型死循环）
JARVIS_MAX_TOOL_ROUNDS=4
# 正则快速路径：命中即本地执行、不经过 LLM（TUI 里可用 /local 临时切换）
JARVIS_LOCAL_SKILLS=true
