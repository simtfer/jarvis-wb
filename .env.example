# === 贾维斯配置 ===
# 复制本文件为 .env 并填入真实值

# LLM 提供商: echo(离线演示) | openai_compat(任何 OpenAI 兼容接口)
JARVIS_PROVIDER=echo

# OpenAI 兼容接口配置（DeepSeek / Kimi / 通义 / 自建网关均可）
JARVIS_API_KEY=
JARVIS_BASE_URL=https://api.deepseek.com/v1
JARVIS_MODEL=deepseek-chat

# 记忆保留的最大对话轮数
JARVIS_MAX_TURNS=20

# 单次模型请求超时（秒）。超时会中止本轮并给出提示，不让界面无声卡住
JARVIS_REQUEST_TIMEOUT=45

# ---- v0.2：流式输出与工具调用 ----
# 流式输出（逐字显示）
JARVIS_STREAM=true
# 是否把本地技能作为工具交给 LLM 调用（function calling）
JARVIS_TOOLS=true
# 单次对话内最多几轮工具调用（防止模型死循环；同一工具的重复调用会被自动熔断）
JARVIS_MAX_TOOL_ROUNDS=3
# 正则快速路径：命中即本地执行、不经过 LLM（TUI 里可用 /local 临时切换）
JARVIS_LOCAL_SKILLS=true

# ---- v0.3：长期记忆 ----
# 记忆库位置（memory.json 所在目录，默认 <项目>/data，已被 .gitignore 排除）
# JARVIS_DATA_DIR=D:/tmp/jarvis/data
# 每轮对话前自动召回相关记忆注入 system prompt
JARVIS_AUTO_RECALL=true
# 自动召回最多注入几条
JARVIS_RECALL_TOP_K=3

# ---- v0.4：系统控制 ----
# 命令执行默认关闭；开启后也只有白名单前缀内的命令能跑，黑名单仍然一票否决
JARVIS_SHELL_ENABLED=false
# 逗号分隔的命令前缀白名单，例如：python,git status,dir
JARVIS_SHELL_ALLOW=
# 单条命令超时（秒）。超时会杀掉整个进程树并立即返回，不会挂在后台进程上
JARVIS_SHELL_TIMEOUT=30
